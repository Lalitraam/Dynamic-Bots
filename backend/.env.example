# Doppelgambit Environment Configuration Example

SESSION_SECRET=your_secret_key_here
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Optional - fallback to console logger in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@doppelgambit.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
